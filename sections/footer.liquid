<footer
  style="background-color: {{ section.settings.color_bg_footer }}"
  class="py-8 {{ section.settings.footer_paddingY }}"
>
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    if section.blocks.size == 1 and section.blocks[0].type == 'brand_information' and brand_empty and has_social_icons == false and section.settings.newsletter_enable == false and section.settings.enable_follow_on_shop == false
      assign only_empty_brand = true
    endif
  -%}
  {%- if section.blocks.size > 0
    or section.settings.newsletter_enable
    or section.settings.show_social
    and has_social_icons == true
    or section.settings.enable_follow_on_shop
  -%}
    {%- unless only_empty_brand -%}
      <div class="container px-4 lg:px-0 lg:flex lg:justify-between lg:items-start">
        <!-- News letter, follow up and show social -->
        <div class="mb-6 w-full flex flex-col gap-4 justify-center items-center sm:mb-12 lg:mb-0 lg:w-1/2 lg:justify-start lg:items-start">
          {%- if section.settings.newsletter_enable -%}
            <div class="flex flex-col justify-center items-center gap-4 lg:justify-start">
              {%- if section.settings.newsletter_heading != blank -%}
                <span class="newsletter_heading mx-2 block text-sm text-center mb-6 font-normal sm:w-72 lg:mx-0 lg:text-left lg:w-96 lg:px-4">
                  {{- section.settings.newsletter_heading -}}
                </span>
              {%- endif -%}
              {%- form 'customer', id: 'ContactFooter', class: '' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="">
                  <div class="flex flex-col justify-center items-center gap-4">
                    <input
                      style="
                        font-family: {{ settings.type_body_font.family }};
                        font-weight: {{ settings.type_body_font.weight }};
                        background-color: {{ section.settings.newsletter_input_bg_color }};
                        border-radius: {{ section.settings.newsletter_button_radius }}px;
                      "
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="inputEntry py-4 pl-4 w-72 sm:py-5 sm:w-[350px] sm:mx-0 sm:px-3"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <button
                      type="submit"
                      style="
                        font-family: {{ settings.type_body_font.family }};
                        font-weight: {{ settings.type_body_font.weight }};
                        background-color: {{ section.settings.newsletter_button_bg_color }};
                        color: {{ section.settings.newsletter_button_text_color }};
                        border-radius: {{ section.settings.newsletter_button_radius }}px;
                      "
                      class="w-72 text-white block px-8 py-4 rounded-lg sm:w-[350px]"
                      name="commit"
                      id="Subscribe"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      Subscribe
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="ContactFooter-error">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                </div>
                {%- if form.posted_successfully? -%}
                  <h3
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-success.svg' | inline_asset_content -}}
                    </span>
                    {{- 'newsletter.success' | t }}
                  </h3>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}
          {%- if section.settings.show_social and has_social_icons -%}
            {%- render 'social-icons',
              colorIcon: section.settings.social_icon_color,
              class: 'flex justify-start items-center my-4 gap-4 lg:px-4'
            -%}
          {%- endif -%}
        </div>
        {%- if section.blocks.size > 0 -%}
          <div class="lg:w-1/2">
            {%- for block in section.blocks -%}
              <div class="">
                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                  {%- when 'link_list' -%}
                    {%- if block.settings.menu != blank -%}
                      <ul class="w-full flex flex-col justify-center items-center sm:flex-row sm:justify-between sm:items-start">
                        {% for link in block.settings.menu.links %}
                          {% style %}
                            .menuHeadings{
                              color: {{ block.settings.color_text_menu_heading }};
                              font-family: {{ settings.type_header_font.family }};
                              font-weight: {{ settings.type_header_font.weight }};
                            }
                            .menuLinks{
                              color: {{ block.settings.color_text_menu_link }};
                              font-family: {{ settings.type_body_font.family }};
                              font-weight: {{ settings.type_body_font.weight }};
                            }
                            .menuLinks:hover{
                              color: {{ block.settings.color_text_menu_link_hover }};

                            }
                          {% endstyle %}
                          <div class="w-full flex flex-col justify-center items-start gap-5 mb-4 sm:w-1/2">
                            <h6
                              class="text-lg lg:text-xl menuHeadings"
                            >
                              {{ link.title | escape }}
                            </h6>
                            {% for allLink in link.links %}
                              <a
                                href="{{ allLink.url }}"
                                class="text-sm lg:text-base font-medium text-gray-800 menuLinks"
                              >
                                {{- allLink.title | escape -}}
                              </a>
                            {% endfor %}
                          </div>
                        {% endfor %}
                      </ul>
                    {%- endif -%}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endunless -%}
  {%- endif -%}
  {% if section.settings.certification_image %}
    <div class="py-12 w-24 mx-auto">
      {{
        section.settings.certification_image
        | image_url: width: 600
        | image_tag: alt: 'Certification', class: 'w-full h-full object-cover object-center'
      }}
    </div>
  {% endif %}

  <div class="container px-4">
    <div class="">
      <div class="">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterLanguageLabel">
                  {{ 'localization.language_label' | t }}
                </h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      {% comment %}
        <div class="">
          {%- if section.settings.payment_enable -%}
            <div class="">
              <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
              <ul class="" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li class="list-payment__item">
                    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      {% endcomment %}
    </div>
    <div class="">
      <div class="flex flex-col justify-center items-center gap-2 sm:flex-row sm:justify-start sm:items-center">
        <small class="text-base text-center text-white"
          >&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url -}}
        </small>
        <small class="text-base text-center text-white">{{ powered_by_link }}</small>
        <a href="#" class="text-base text-center text-white">Ezagrow LLC</a>
        {%- if section.settings.show_policy -%}
          <ul class="">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <small class="text-white text-base"
                    ><a href="{{ policy.url }}">{{ policy.title | escape }}</a></small
                  >
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% style %}
  .newsletter_heading {
    color: {{ section.settings.newsletter_text_color }};
    font-family: {{ settings.type_body_font.family }};
    font-weight: {{ settings.type_body_font.weight }};
  },
{% endstyle %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        },
        {
          "type": "header",
          "content": "styles"
        },
        {
          "type": "color",
          "id": "color_text_menu_heading",
          "label": "Color text menu heading",
          "default": "#000000",
          "info": "This is for the color text menu heading"
        },
        {
          "type": "color",
          "id": "color_text_menu_link",
          "label": "Color text menu link",
          "default": "#000000",
          "info": "This is for the color text menu link"
        },
        {
          "type": "color",
          "id": "color_text_menu_link_hover",
          "label": "Color text menu link hover",
          "default": "#000000",
          "info": "This is for the color text menu link hover"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Footer settings",
      "info": "Footer settings"
    },
    {
      "type": "color",
      "id": "color_bg_footer",
      "label": "Footer background color",
      "default": "#f9f9f9",
      "info": "This is for the footer background color"
    },
    {
      "type": "select",
      "id": "footer_paddingY",
      "label": "Footer padding top and bottom",
      "options": [
        {
          "value": "lg:py-4",
          "label": "16"
        },
        {
          "value": "lg:py-8",
          "label": "32"
        },
        {
          "value": "lg:py-12",
          "label": "48"
        },
        {
          "value": "lg:py-16",
          "label": "64"
        },
        {
          "value": "lg:py-20",
          "label": "80"
        }
      ],
      "default": "lg:py-8"
    },
    {
      "type": "image_picker",
      "id": "certification_image",
      "label": "Certification image",
      "info": "This is for the certification image"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content",
      "info": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "t:sections.footer.settings.newsletter_heading.default",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "color",
      "id": "newsletter_text_color",
      "label": "Newsletter text color",
      "default": "#000000",
      "info": "This is for the newsletter text color"
    },
    {
      "type": "color",
      "id": "newsletter_input_bg_color",
      "label": "Newsletter input background color",
      "default": "#ffffff",
      "info": "This is for the newsletter input background color"
    },
    {
      "type": "color",
      "id": "newsletter_button_bg_color",
      "label": "Newsletter button background color",
      "default": "#000000",
      "info": "This is for the newsletter input background color"
    },
    {
      "type": "color",
      "id": "newsletter_button_text_color",
      "label": "Newsletter button text color",
      "default": "#ffffff",
      "info": "This is for the newsletter input background color"
    },
    {
      "type": "range",
      "id": "newsletter_button_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Newsletter button radius",
      "default": 4,
      "info": "This is for the newsletter button radius"
    },
    {
      "type": "header",
      "content": "Social icons color",
      "info": "This is for the social icons color"
    },
    {
      "type": "color",
      "id": "social_icon_color",
      "label": "Social icon color",
      "default": "#000000",
      "info": "This is for the social icon color"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__9.content",
      "info": "t:sections.footer.settings.header__9.info"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
      "label": "t:sections.footer.settings.enable_follow_on_shop.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__2.content",
      "info": "t:sections.footer.settings.header__2.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__3.content",
      "info": "t:sections.footer.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__5.content",
      "info": "t:sections.footer.settings.header__6.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_language_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__7.content"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__8.content",
      "info": "t:sections.footer.settings.header__8.info"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      }
    ]
  }
}
{% endschema %}
