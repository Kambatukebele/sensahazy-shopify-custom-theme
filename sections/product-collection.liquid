<section
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px"
  class="px-4 md:px-8 py-6 lg:flex lg:justify-center"
>
  <div
    id="productScroller"
    class="flex overflow-x-auto pb-4 space-x-4 scrollbar-hide"
    data-scroll-container
  >
    {%- for product in section.settings.product_list -%}
      <div class="w-40 h-fit p-5 rounded-lg bg-white border-gray-200 border flex-shrink-0 lg:w-56">
        <div class="aspect-square  rounded-lg overflow-hidden">
          {{
            product.featured_image
            | image_url: width: 300
            | image_tag: loading: 'lazy', class: 'w-full h-full object-cover'
          }}
        </div>
        <div class="mt-3">
          <span class="block font-medium text-lg mb-1 lg:text-2xl text-black">{{ product.title | capitalize }}</span>
          <span class="text-gray-600">
            Plan à partir de
            {{ product.price | money }}
          </span>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

{% comment %} ==== SCROLL BEHAVIOR ==== {% endcomment %}
{{ 'scroll-behavior-polyfill.js' | asset_url | script_tag }}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scroller = document.querySelector('#productScroller');
    let isDragging = false;
    let startX;
    let scrollLeft;

    // Desktop drag scroll
    scroller.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.pageX - scroller.offsetLeft;
      scrollLeft = scroller.scrollLeft;
      scroller.classList.add('cursor-grabbing');
    });

    scroller.addEventListener('mouseup', () => {
      isDragging = false;
      scroller.classList.remove('cursor-grabbing');
    });

    scroller.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - scroller.offsetLeft;
      const walk = x - startX;
      scroller.scrollLeft = scrollLeft - walk;
    });

    // Mobile touch scroll
    scroller.addEventListener(
      'touchstart',
      (e) => {
        startX = e.touches[0].pageX;
        scrollLeft = scroller.scrollLeft;
      },
      { passive: true }
    );

    scroller.addEventListener(
      'touchmove',
      (e) => {
        if (!isDragging) {
          const touchX = e.touches[0].pageX;
          const walk = touchX - startX;
          scroller.scrollLeft = scrollLeft - walk;
        }
      },
      { passive: true }
    );
  });
</script>

{% schema %}
{
  "name": "Product collection",
  "class": "productCollection",
  "settings": [
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Product list"
    },
    {
      "type": "header",
      "content": "Paddings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Product collection"
    }
  ]
}
{% endschema %}
