<header class="relative w-full h-fit">
  <div
    class="fixed z-50 h-fit backgroundContainer top-14 left-3 right-3 rounded-lg py-4 px-4 delay-300 ease-in-out"
    data-bg-color-default="{{ section.settings.bg_color_default }}"
    data-text-color-default="{{ section.settings.text_color_default }}"
    data-icon-color-default="{{ section.settings.icon_color_default }}"
    data-bg-color-scroll="{{ section.settings.bg_color_scroll }}"
    data-text-color-scroll="{{ section.settings.text_color_scroll }}"
    data-icon-color-scroll="{{ section.settings.icon_color_scroll }}"
  >
    <div class="flex justify-between items-center">
      <!-- Icons hamburger and close -->
      <div class="flex justify-center items-center">
        <span class="icon-hamburger pl-1 block cursor-pointer">
          {{- 'icon-hamburger.svg' | inline_asset_content -}}
        </span>
        <span class="icon-close hidden cursor-pointer">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </div>
      <!-- End Icons hamburger and close -->
      <!-- Logo -->
      <a href="{{ shop.url }}" class="">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 1000 | image_tag: class: '' }}
        {%- else -%}
          <span style="color:{{ section.settings.text_color_scroll }}" class="uppercase text-xl font-bold">
            {{- shop.name -}}
          </span>
        {%- endif -%}
      </a>
      <!-- End Logo -->
      <!-- Icons account and cart -->
      <div class="flex justify-end">
        <span class="icon-cart block ml-2">
          {{- 'icon-cart.svg' | inline_asset_content -}}
        </span>
      </div>
      <!-- End Icons account and cart -->
    </div>
    <!-- Navigation -->
    <div class="w-full navigation h-0 overflow-hidden duration-300 ease-in-out">
      <span class="text-xs uppercase font-semibold">Shop</span>
      <ul class="flex flex-col justify-center items-start gap-2">
        {%- for menu in section.settings.menu.links -%}
          <li class="navigationLink {{ section.settings.text_menu_size }} {{ section.settings.text_menu_transform }} font-semibold">
            <a href="{{ menu.url }}">{{ menu.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <!-- End Navigation -->
  </div>
  <!-- Background image -->
  {% if template == 'index' %}
    <div class="w-full flex min-h-[calc(100svh-34px)] flex-col overflow-clip md:h-[calc(100vh/1.4)] md:min-h-[720px] md:flex-row-reverse lg:min-h-[800px]">
      <!-- Image -->
      <div class="aspect-square grow md:w-3/5">
        {% if section.settings.bg_image %}
          {{
            section.settings.bg_image
            | image_url: width: 1150, height: 1117
            | image_tag: class: 'full h-full object-center object-cover'
          }}
        {% endif %}
      </div>
      <!-- Text -->
      <div
        style="background-color: {{ section.settings.bg_color }}"
        class="space-y-4 flex flex-col justify-center items-start gap-3 px-8 py-10 text-default md:w-2/5 md:content-center md:space-y-6 md:px-10 md:py-6 lg:px-20 lg:py-12"
      >
        <h1 class="headingText {{ section.settings.heading_text_transform }} {{ section.settings.heading_text_size_phone }} {{ section.settings.heading_text_size_tablet }} {{ section.settings.heading_text_size_desktop }}">
          {{ section.settings.heading_text }}
        </h1>
        <p class="headerParagraph text-base sm:text-lg">
          {{ section.settings.paragraph_text }}
        </p>
        <div class="flex flex-row flex-wrap items-center gap-4">
          <button
            class="relative py-4 px-8 buttonHeader"
          >
            <a
              class="{{ section.settings.button_text_transform }} buttonHeaderLink"
              href="{{ section.settings.button_link }}"
            >
              {{ section.settings.button_text }}
            </a>
          </button>
        </div>
      </div>
    </div>
  {% endif %}
  <!-- End Background image -->
</header>

{% style %}
  .headingText{
      font-family: "Montserrat Black Bold";
      font-weight: 900;
      color: {{ section.settings.heading_text_color }};
  }
  .headerParagraph{
      font-family: {{ settings.type_body_font.family }};
      font-weight: {{ settings.type_body_font.weight }};
      color: {{ section.settings.paragraph_text_color }};
  }
  .buttonHeader{
      font-family: {{ settings.type_body_font.family }};
      font-weight: {{ settings.type_body_font.weight }};
      background-color: {{ section.settings.button_bg_color }};
      border-radius: {{ section.settings.button_border_radius }}px
  }
  .buttonHeaderLink{
      font-family: {{ settings.type_body_font.family }};
      font-weight: {{ settings.type_body_font.weight }};
      color: {{ section.settings.button_text_color }};

    }
    .navigationLink{
      font-weight: {{ settings.type_body_font.weight }};
      font-family: {{ settings.type_body_font.family }};
    }
    /* Smooth background transition */
    .backgroundContainer {
      transition: background-color 0.4s ease-in-out, transform 0.4s ease-in-out;
      transform: translateY(-10px);
    }

    .backgroundContainer.show {
      transform: translateY(0);
    }
{% endstyle %}

{% javascript %}
  const iconHamburger = document.querySelector('.icon-hamburger');
  const iconClose = document.querySelector('.icon-close');
  const backgroundContainer = document.querySelector('.backgroundContainer');
  const navigation = document.querySelector('.navigation');
  const icons = document.querySelectorAll('.icon-hamburger, .icon-close, .icon-account, .icon-cart');
  const textElements = document.querySelectorAll('.navigation a, .navigation span');

  const heroSection = document.querySelector('header .w-full.h-full.lg\\:h-screen');

  // Get default and scroll colors from Liquid data attributes
  const bgColorDefault = backgroundContainer.dataset.bgColorDefault || 'transparent';
  const textColorDefault = backgroundContainer.dataset.textColorDefault || '#ffffff';
  const iconColorDefault = backgroundContainer.dataset.iconColorDefault || '#ffffff';

  const bgColorScroll = backgroundContainer.dataset.bgColorScroll || '#000000';
  const textColorScroll = backgroundContainer.dataset.textColorScroll || '#ffffff';
  const iconColorScroll = backgroundContainer.dataset.iconColorScroll || '#ffffff';

  let menuOpen = false; // Track menu state

  // Apply default styles on load
  function applyDefaultStyles() {
    if (window.innerWidth < 1024) {
      // If screen width is less than 1024px (mobile), always apply scroll colors
      backgroundContainer.style.backgroundColor = bgColorScroll;
      textElements.forEach((el) => (el.style.color = textColorScroll));
      icons.forEach((icon) => (icon.style.color = iconColorScroll));
    } else {
      // For larger screens, apply the default colors
      backgroundContainer.style.backgroundColor = bgColorDefault;
      textElements.forEach((el) => (el.style.color = textColorDefault));
      icons.forEach((icon) => (icon.style.color = iconColorDefault));
    }
  }

  function applyScrollStyles() {
    backgroundContainer.style.backgroundColor = bgColorScroll;
    textElements.forEach((el) => (el.style.color = textColorScroll));
    icons.forEach((icon) => (icon.style.color = iconColorScroll));
  }

  applyDefaultStyles(); // Set initial styles

  // Function to update colors on scroll
  function updateColorsOnScroll() {
    if (window.innerWidth < 1024) return; // Ignore scroll color changes on small screens

    let theScroll = window.scrollY;
    let heroHeight = heroSection.offsetHeight;

    if (menuOpen) {
      applyScrollStyles();
    } else {
      if (theScroll > heroHeight) {
        applyScrollStyles();
      } else {
        applyDefaultStyles();
      }
    }
  }

  // Scroll event listener
  window.addEventListener('scroll', updateColorsOnScroll);

  // Open menu event
  iconHamburger.addEventListener('click', () => {
    menuOpen = true;
    navigation.classList.remove('h-0', 'overflow-hidden');
    navigation.classList.add('h-[200px]', 'overflow-visible');
    iconHamburger.classList.add('hidden');
    iconClose.classList.remove('hidden');

    applyScrollStyles(); // Apply scroll colors when menu opens
  });

  // Close menu event
  iconClose.addEventListener('click', () => {
    menuOpen = false;
    navigation.classList.add('h-0', 'overflow-hidden');
    navigation.classList.remove('h-[200px]', 'overflow-visible');
    iconHamburger.classList.remove('hidden');
    iconClose.classList.add('hidden');

    // Restore colors based on scroll position
    updateColorsOnScroll();
  });
{% endjavascript %}

